# Where the test environment is deployed. Read by deploy/deploy.ps1 (or .sh)
# and deploy/setup-secrets.ps1 (or .sh). For prod, copy this folder to
# deploy/prod/ and change the names.

PROJECT=aire-data
REGION=asia-southeast1
REGISTRY=asia-southeast1-docker.pkg.dev/aire-data/aireos-test
API_SERVICE=aireos-api-test
WEB_SERVICE=aireos-web-test
API_SERVICE_ACCOUNT=aireos-api@aire-data.iam.gserviceaccount.com
WEB_SERVICE_ACCOUNT=aireos-web@aire-data.iam.gserviceaccount.com
