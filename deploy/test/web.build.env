# Build arguments for the aireos-web-test image. They are compiled into the
# Next.js build, so changing one means rebuilding the image, not just
# redeploying. Nothing here may be secret: NEXT_PUBLIC_* values are visible to
# every visitor.

# The browser calls the web service itself; /api/* is forwarded to the API.
NEXT_PUBLIC_API_URL=https://aireos-web-test-55957091068.asia-southeast1.run.app
# Must match AUTH_ENABLED in api.env.yaml.
NEXT_PUBLIC_AUTH_ENABLED=true
# Where the web service forwards /api/* (next.config.mjs rewrites).
BACKEND_API_URL=https://aireos-api-test-55957091068.asia-southeast1.run.app
