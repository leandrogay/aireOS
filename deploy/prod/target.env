# Where the prod environment is deployed. Read by deploy/deploy.ps1 (or .sh)
# and deploy/setup-secrets.ps1 (or .sh). Same layout as deploy/test/ with the
# -test suffix dropped from every name.

PROJECT=aire-data
REGION=asia-southeast1
REGISTRY=asia-southeast1-docker.pkg.dev/aire-data/aireos
API_SERVICE=aireos-api
WEB_SERVICE=aireos-web
API_SERVICE_ACCOUNT=aireos-api@aire-data.iam.gserviceaccount.com
WEB_SERVICE_ACCOUNT=aireos-web@aire-data.iam.gserviceaccount.com
