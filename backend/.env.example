# Raw upload and mapping services
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
SERVICE_ACCOUNT_KEY_PATH=C:\path\to\service-account.json
GCP_PROJECT_ID=your-project-id
GCS_BUCKET_NAME=your-bucket-name
GCS_DESTINATION_PREFIX=uploads/
GCS_DESTINATION_PREFIX_MAPPING=mappings/
ANTHROPIC_API_KEY=

# PostgreSQL Cloud SQL
POSTGRESQL_INSTANCE_CONNECTION_NAME=project:region:instance
DB_IAM_USER=service-account@project.iam
DB_NAME=promotions

# Keep false until migrations/001_create_sellout.sql has been reviewed and run.
CLOUD_SQL_LOAD_ENABLED=false
