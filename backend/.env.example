# Copy to .env.backend and fill in. Never commit .env.backend.
# Path settings may be relative to backend/ -- they are resolved against it,
# not the working directory, so the app runs the same from anywhere.

# ---- Google Cloud ----
# Both key paths are optional. Leave them unset to use Application Default
# Credentials instead: the service's own service account on Cloud Run, or
# `gcloud auth application-default login` on your machine.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
SERVICE_ACCOUNT_KEY_PATH=./gcp-key.json
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_DESTINATION_PREFIX=uploads/
GCS_DESTINATION_PREFIX_MAPPING=mappings/

# ---- BigQuery ----
# Legacy and unused by the app; defaults to aire-data.Aire_Data.aireOS_fairprice
BQ_FAIRPRICESELLOUT_TABLE=
# Optional; defaults to aire-data.Aire_Data_Analytics.aire_forecasting_output
BQ_FORECAST_OUTPUT_VIEW=

# ---- HTTP ----
# Comma-separated browser origins allowed to call the API.
# Optional; defaults to http://localhost:3000,http://127.0.0.1:3000
# In the cloud, set it to the app's domain, e.g. https://aireos.example.com
CORS_ALLOWED_ORIGINS=

# ---- Cloud SQL ----
POSTGRESQL_INSTANCE_CONNECTION_NAME=
DB_IAM_USER=
DB_NAME=
# Keep false until migrations/001_create_sellout.sql has been reviewed and run.
CLOUD_SQL_LOAD_ENABLED=false

# ---- Mapping model (Gemini on Vertex AI) ----
# Uses GCP_PROJECT_ID and the Google credentials above -- no API key.
# Optional; defaults to gemini-3.8-flash
MAPPING_MODEL=
# Optional; defaults to global (Google picks the processing region).
# Use a region such as asia-southeast1 to pin it.
MAPPING_VERTEX_LOCATION=

# ---- Gemini (in-app assistant, via Vertex AI) ----
# Optional; defaults to gemini-3.8-flash
GEMINI_ASSISTANT_MODEL=
# Optional; defaults to global (gemini-3.8-flash is not served from regional locations)
GCP_VERTEX_LOCATION=

# ---- Google Workspace SSO ----
# Keep false for local development until the OAuth client values below exist.
AUTH_ENABLED=false
# Generate a long random value; never reuse the OAuth client secret here.
AUTH_SESSION_SECRET=
AUTH_ALLOWED_DOMAIN=shop-aire.com
AUTH_FRONTEND_URL=http://localhost:3000
AUTH_COOKIE_SECURE=false
# Leave blank on localhost. In production, use the shared parent domain, e.g. .shop-aire.com.
AUTH_COOKIE_DOMAIN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an authorised redirect URI on the Google OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
# ---- Notifications ----
# Optional; the Pub/Sub subscription the scheduled BigQuery forecast reports to.
# Empty: the backend does not listen for scheduled forecast runs.
FORECAST_PIPELINE_SUBSCRIPTION=
